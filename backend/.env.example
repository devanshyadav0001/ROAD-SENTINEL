# Database
DATABASE_URL=postgresql+asyncpg://roads_user:changeme@db:5432/roads
POSTGRES_DB=roads
POSTGRES_USER=roads_user
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=road-sentinel-speed-tracker-dev-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Device keys
DEVICE_KEY_SALT=road-sentinel-device-salt-key-999

# Settings
ALLOW_OLD_TIMESTAMPS=true
RETENTION_RAW_DAYS=30
MIN_TRIPS_FOR_STATS=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
